<odoo>
    <data>
        <record id="llm_config_tree_view" model="ir.ui.view">
            <field name="name">LLM List</field>
            <field name="model">llm.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="model"/>
                    <field name="model_URL"/>
                    <field name="temperature"/>
                    <field name="temperature"/>
                    <field name="is_out_default"/>
                    <field name="is_chat_default"/>
                </tree>
            </field>
        </record>

        <record id="llm_config_form_view" model="ir.ui.view">
            <field name="name">LLM Form</field>
            <field name="model">llm.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="model"/>
                                <field name="model_URL"/>
                                <field name="temperature"/>
                            </group>
                            <group>
                                <field name="is_out_default"/>
                                <field name="is_chat_default"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="llm_config_search" model="ir.ui.view">
            <field name="name">LLM Search</field>
            <field name="model">llm.config</field>
            <field eval="16" name="priority"/>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="model"/>
                    <field name="model_URL"/>
                    <field name="note"/>
                </search>
            </field>
        </record>
        <record id="llm_config_action" model="ir.actions.act_window">
            <field name="name">LLM</field>
            <field name="res_model">llm.config</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('llm_config_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('llm_config_form_view')}),
                ]"
            />
            <field name="search_view_id" ref="llm_config_search"/>
        </record>
    </data>
</odoo>