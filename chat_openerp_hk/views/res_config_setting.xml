<odoo>
    <data>
        <record id="chat_openerp_hk_res_config_setting_views" model="ir.ui.view">
            <field name="name">Interface</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="chat_openerp_hk" string="chat_openerp_hk" name="chat_openerp_hk_res_config_setting_views" logo="/base/static/description/settings.png">

                        <div id="IP_config">
                            <block title="Interface Config" name="model_config">
                                <setting id="Interface Address">
                                    <field name="IP"/>

                                </setting>

                            </block>
                        </div>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>