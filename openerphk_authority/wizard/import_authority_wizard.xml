<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="import_authority_wizard_form" model="ir.ui.view">
        <field name="name">import.authority.wizard.form</field>
        <field name="model">import.authority.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="file" required="1" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="authority_id" invisible="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="import" class="btn-secondary"/>
                    <button string="cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>